{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abou-etjanst-definition.json",
  "title": "Abou e-tjänst definition",
  "type": "object",
  "required": ["shortName", "displayName", "pages"],
  "additionalProperties": false,
  "properties": {
    "shortName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$",
      "description": "Unique service code. Used as ServiceShortName and as the prefix of every FriendlyFieldID."
    },
    "displayName": { "type": "string" },
    "menuDisplayName": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "organisationName": { "type": "string" },
    "organisationId": { "type": "integer" },
    "availableCitizen": { "type": "boolean", "default": true },
    "availableCompany": { "type": "boolean", "default": false },
    "availableClub": { "type": "boolean", "default": false },
    "isEnabled": { "type": "boolean", "default": false },
    "requiresAuthentication": { "type": "boolean", "default": true },
    "requiresSignature": { "type": "boolean", "default": true },
    "requireEID": { "type": "boolean", "default": true },
    "requiresPayment": { "type": "boolean", "default": false },
    "isAnonymous": { "type": "boolean", "default": false },
    "caseStatusList": { "type": "string" },
    "note": { "type": ["string", "null"] },
    "type": { "type": "string", "default": "Internal" },
    "infoHtml": { "type": "string", "description": "If set, an InfoPage is prepended." },
    "thankYouHtml": { "type": "string" },
    "howItWorksInformation": { "type": ["string", "null"] },
    "myCasesInformation": { "type": ["string", "null"] },
    "processingTime": { "type": ["string", "null"] },
    "updatedBy": {
      "type": "string",
      "default": "hani001",
      "description": "Abou username written to Service UpdatedBy."
    },
    "updatedByName": {
      "type": "string",
      "default": "Hampus Nilsson",
      "description": "Display name written to Service UpdatedByName."
    },
    "version": {
      "type": "integer",
      "default": 1,
      "description": "Service Version. Keep 1 for new packages; copy from an export when cloning."
    },
    "serviceNr": { "type": "integer", "description": "Abou ServiceNr; used in the zip file name." },
    "exportDate": {
      "type": "string",
      "description": "YYYY-MM-DD used in the zip name and LastUpdated. Defaults to today."
    },
    "idStart": { "type": "integer", "default": 1000 },
    "properties": { "type": "array", "items": { "type": "string" } },
    "slotSettings": { "type": "object" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "headerHtml": { "type": ["string", "null"] },
        "infoBoxTitle": { "type": ["string", "null"] },
        "infoBoxHtml": { "type": ["string", "null"] },
        "showInSummary": { "type": "boolean" },
        "showInMenu": { "type": "boolean" },
        "url": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["form", "info", "summary", "sign", "thankyou", "payment", "paymentthankyou"]
        },
        "pageNodeXml": {
          "type": "string",
          "description": "Optional IronPython ObjectFactory XML for custom page flow."
        },
        "activationRule": { "type": "object" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": ["integer", "string"] },
        "type": { "type": "string" },
        "question": { "type": "string", "description": "May be empty for EGovLabelField; put heading HTML in preFieldHtml." },
        "required": { "type": "boolean", "default": false },
        "alternatives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "textFieldNrOfRows": { "type": "integer" },
        "preFieldHtml": { "type": ["string", "null"] },
        "postFieldHtml": { "type": ["string", "null"] },
        "infoButtonText": { "type": ["string", "null"] },
        "mouseOverText": { "type": ["string", "null"] },
        "summaryQuestion": { "type": ["string", "null"] },
        "enabled": { "type": "boolean" },
        "hide": { "type": "boolean" },
        "allowMultiple": { "type": "boolean" },
        "maxFileSize": { "type": "number" },
        "requireFileDescription": { "type": "boolean" },
        "columns": {
          "type": "array",
          "description": "Add-rows column titles. Length must match EGovAddRowsNColumnsListField.",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "question": { "type": "string" },
                  "label": { "type": "string" },
                  "validator": { "type": "string" },
                  "summarizedNumbers": { "type": ["string", "boolean"] }
                }
              }
            ]
          }
        },
        "requiredWhen": {
          "oneOf": [
            { "$ref": "#/$defs/requiredWhen" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/requiredWhen" }
            }
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": ["string", "boolean", "number"] },
              "type": { "type": "string" }
            }
          }
        }
      }
    },
    "requiredWhen": {
      "type": "object",
      "required": ["field", "answer"],
      "properties": {
        "field": { "type": ["integer", "string"] },
        "answer": { "type": "string" },
        "errorText": { "type": "string" }
      }
    }
  }
}
